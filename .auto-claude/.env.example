# Auto-Claude environment example (H1 hygiene).
# Copy to .auto-claude/.env and fill in real values locally.
# .auto-claude/.env itself is gitignored and must never be committed.

CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
LINEAR_MCP_ENABLED=
GITLAB_ENABLED=
CONTEXT7_ENABLED=
GRAPHITI_ENABLED=
ELECTRON_MCP_ENABLED=
PUPPETEER_MCP_ENABLED=
ENABLE_FANCY_UI=
